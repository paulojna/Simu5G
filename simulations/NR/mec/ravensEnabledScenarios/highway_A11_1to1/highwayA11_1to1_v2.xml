<config>
    <!-- ========================================= -->
    <!-- CORE NETWORK STATIC ADDRESSING           -->
    <!-- Using actual interface names from dump   -->
    <!-- ========================================= -->

    <!-- MecHost virtualisationInfrastructure interfaces (where MEC apps run) -->
    <!-- External connection to iUpf -->
    <interface hosts="mecHost1.virtualisationInfrastructure" names="pppIf0" address="10.1.1.x" netmask="255.255.255.252"/>
    <interface hosts="mecHost2.virtualisationInfrastructure" names="pppIf0" address="10.1.2.x" netmask="255.255.255.252"/>
    <interface hosts="mecHost3.virtualisationInfrastructure" names="pppIf0" address="10.1.3.x" netmask="255.255.255.252"/>
    <interface hosts="mecHost4.virtualisationInfrastructure" names="pppIf0" address="10.1.4.x" netmask="255.255.255.252"/>
    <interface hosts="mecHost5.virtualisationInfrastructure" names="pppIf0" address="10.1.5.x" netmask="255.255.255.252"/>
    <interface hosts="mecHost6.virtualisationInfrastructure" names="pppIf0" address="10.1.6.x" netmask="255.255.255.252"/>

    <!-- MecHost internal upf_mec interfaces (connects virtualisationInfrastructure to iUpf) -->
    <interface hosts="mecHost1.upf_mec" names="pppIf" address="10.5.1.x" netmask="255.255.255.252"/>
    <interface hosts="mecHost2.upf_mec" names="pppIf" address="10.5.2.x" netmask="255.255.255.252"/>
    <interface hosts="mecHost3.upf_mec" names="pppIf" address="10.5.3.x" netmask="255.255.255.252"/>
    <interface hosts="mecHost4.upf_mec" names="pppIf" address="10.5.4.x" netmask="255.255.255.252"/>
    <interface hosts="mecHost5.upf_mec" names="pppIf" address="10.5.5.x" netmask="255.255.255.252"/>
    <interface hosts="mecHost6.upf_mec" names="pppIf" address="10.5.6.x" netmask="255.255.255.252"/>

    <!-- MecHost virtualisationInfrastructure internal connection to upf_mec -->
    <interface hosts="mecHost1.virtualisationInfrastructure" names="pppIf1" address="10.5.1.x" netmask="255.255.255.252"/>
    <interface hosts="mecHost2.virtualisationInfrastructure" names="pppIf1" address="10.5.2.x" netmask="255.255.255.252"/>
    <interface hosts="mecHost3.virtualisationInfrastructure" names="pppIf1" address="10.5.3.x" netmask="255.255.255.252"/>
    <interface hosts="mecHost4.virtualisationInfrastructure" names="pppIf1" address="10.5.4.x" netmask="255.255.255.252"/>
    <interface hosts="mecHost5.virtualisationInfrastructure" names="pppIf1" address="10.5.5.x" netmask="255.255.255.252"/>
    <interface hosts="mecHost6.virtualisationInfrastructure" names="pppIf1" address="10.5.6.x" netmask="255.255.255.252"/>

    <!-- iUpf interfaces: ppp0=mecHost, ppp1=upf, ppp2=gnb -->
    <interface hosts="iUpf1" names="ppp0" address="10.1.1.x" netmask="255.255.255.252"/>  <!-- to mecHost1 -->
    <interface hosts="iUpf1" names="ppp1" address="10.2.1.x" netmask="255.255.255.252"/>  <!-- to upf -->
    <interface hosts="iUpf1" names="ppp2" address="10.3.1.x" netmask="255.255.255.252"/>  <!-- to gnb1 -->

    <interface hosts="iUpf2" names="ppp0" address="10.1.2.x" netmask="255.255.255.252"/>  <!-- to mecHost2 -->
    <interface hosts="iUpf2" names="ppp1" address="10.2.2.x" netmask="255.255.255.252"/>  <!-- to upf -->
    <interface hosts="iUpf2" names="ppp2" address="10.3.2.x" netmask="255.255.255.252"/>  <!-- to gnb2 -->

    <interface hosts="iUpf3" names="ppp0" address="10.1.3.x" netmask="255.255.255.252"/>  <!-- to mecHost3 -->
    <interface hosts="iUpf3" names="ppp1" address="10.2.3.x" netmask="255.255.255.252"/>  <!-- to upf -->
    <interface hosts="iUpf3" names="ppp2" address="10.3.3.x" netmask="255.255.255.252"/>  <!-- to gnb3 -->

    <interface hosts="iUpf4" names="ppp0" address="10.1.4.x" netmask="255.255.255.252"/>  <!-- to mecHost4 -->
    <interface hosts="iUpf4" names="ppp1" address="10.2.4.x" netmask="255.255.255.252"/>  <!-- to upf -->
    <interface hosts="iUpf4" names="ppp2" address="10.3.4.x" netmask="255.255.255.252"/>  <!-- to gnb4 -->

    <interface hosts="iUpf5" names="ppp0" address="10.1.5.x" netmask="255.255.255.252"/>  <!-- to mecHost5 -->
    <interface hosts="iUpf5" names="ppp1" address="10.2.5.x" netmask="255.255.255.252"/>  <!-- to upf -->
    <interface hosts="iUpf5" names="ppp2" address="10.3.5.x" netmask="255.255.255.252"/>  <!-- to gnb5 -->

    <interface hosts="iUpf6" names="ppp0" address="10.1.6.x" netmask="255.255.255.252"/>  <!-- to mecHost6 -->
    <interface hosts="iUpf6" names="ppp1" address="10.2.6.x" netmask="255.255.255.252"/>  <!-- to upf -->
    <interface hosts="iUpf6" names="ppp2" address="10.3.6.x" netmask="255.255.255.252"/>  <!-- to gnb6 -->

    <!-- Central UPF interfaces: ppp0-5 connect to iUpf1-6 -->
    <interface hosts="upf" names="ppp0" address="10.2.1.x" netmask="255.255.255.252"/>  <!-- to iUpf1 -->
    <interface hosts="upf" names="ppp1" address="10.2.2.x" netmask="255.255.255.252"/>  <!-- to iUpf2 -->
    <interface hosts="upf" names="ppp2" address="10.2.3.x" netmask="255.255.255.252"/>  <!-- to iUpf3 -->
    <interface hosts="upf" names="ppp3" address="10.2.4.x" netmask="255.255.255.252"/>  <!-- to iUpf4 -->
    <interface hosts="upf" names="ppp4" address="10.2.5.x" netmask="255.255.255.252"/>  <!-- to iUpf5 -->
    <interface hosts="upf" names="ppp5" address="10.2.6.x" netmask="255.255.255.252"/>  <!-- to iUpf6 -->

    <!-- gNB backhaul interfaces to iUpfs -->
    <interface hosts="gnb1" names="pppIf" address="10.3.1.x" netmask="255.255.255.252"/>
    <interface hosts="gnb2" names="pppIf" address="10.3.2.x" netmask="255.255.255.252"/>
    <interface hosts="gnb3" names="pppIf" address="10.3.3.x" netmask="255.255.255.252"/>
    <interface hosts="gnb4" names="pppIf" address="10.3.4.x" netmask="255.255.255.252"/>
    <interface hosts="gnb5" names="pppIf" address="10.3.5.x" netmask="255.255.255.252"/>
    <interface hosts="gnb6" names="pppIf" address="10.3.6.x" netmask="255.255.255.252"/>

    <!-- X2 interfaces between gNBs for handover -->
    <!-- gnb1 <--> gnb2 link -->
    <interface hosts="gnb1" names="x2ppp0" address="10.4.1.x" netmask="255.255.255.252"/>
    <interface hosts="gnb2" names="x2ppp0" address="10.4.1.x" netmask="255.255.255.252"/>

    <!-- gnb2 <--> gnb3 link -->
    <interface hosts="gnb2" names="x2ppp1" address="10.4.2.x" netmask="255.255.255.252"/>
    <interface hosts="gnb3" names="x2ppp0" address="10.4.2.x" netmask="255.255.255.252"/>

    <!-- gnb3 <--> gnb4 link -->
    <interface hosts="gnb3" names="x2ppp1" address="10.4.3.x" netmask="255.255.255.252"/>
    <interface hosts="gnb4" names="x2ppp0" address="10.4.3.x" netmask="255.255.255.252"/>

    <!-- gnb4 <--> gnb5 link -->
    <interface hosts="gnb4" names="x2ppp1" address="10.4.4.x" netmask="255.255.255.252"/>
    <interface hosts="gnb5" names="x2ppp0" address="10.4.4.x" netmask="255.255.255.252"/>

    <!-- gnb5 <--> gnb6 link -->
    <interface hosts="gnb5" names="x2ppp1" address="10.4.5.x" netmask="255.255.255.252"/>
    <interface hosts="gnb6" names="x2ppp0" address="10.4.5.x" netmask="255.255.255.252"/>

    <!-- Cellular network - separate from core network addressing -->
    <interface hosts="gnb*" names="cellular" address="10.x.x.x" netmask="255.0.0.0"/>
    <interface hosts="car*" names="cellular" address="10.x.x.x" netmask="255.0.0.0"/>

    <!-- ========================================= -->
    <!-- MANAGEMENT/CONTROL PLANE ADDRESSING      -->
    <!-- Router, UALCMP, RAVENS Controller        -->
    <!-- ========================================= -->

    <!-- UPF filterGate interface (connection to router) -->
    <interface hosts="upf" names="pppIf" address="10.6.1.x" netmask="255.255.255.252"/>

    <!-- Router interfaces -->
    <interface hosts="router" names="ppp0" address="10.6.1.x" netmask="255.255.255.252"/>  <!-- to upf -->
    <interface hosts="router" names="ppp1" address="10.6.2.x" netmask="255.255.255.252"/>  <!-- to ualcmp -->
    <interface hosts="router" names="ppp2" address="10.6.3.x" netmask="255.255.255.252"/>  <!-- to server -->

    <!-- UALCMP interface -->
    <interface hosts="ualcmp" names="pppIf" address="10.6.2.x" netmask="255.255.255.252"/>

    <!-- RAVENS Controller (server) interface -->
    <interface hosts="server" names="pppIf" address="10.6.3.x" netmask="255.255.255.252"/>

    <!-- ========================================= -->
    <!-- STATIC ROUTES ON CENTRAL UPF             -->
    <!-- Routes to reach mecHost subnets via iUpfs -->
    <!-- ========================================= -->

    <route hosts="upf" destination="10.1.1.0" netmask="255.255.255.252" interface="ppp0"/>
    <route hosts="upf" destination="10.1.2.0" netmask="255.255.255.252" interface="ppp1"/>
    <route hosts="upf" destination="10.1.3.0" netmask="255.255.255.252" interface="ppp2"/>
    <route hosts="upf" destination="10.1.4.0" netmask="255.255.255.252" interface="ppp3"/>
    <route hosts="upf" destination="10.1.5.0" netmask="255.255.255.252" interface="ppp4"/>
    <route hosts="upf" destination="10.1.6.0" netmask="255.255.255.252" interface="ppp5"/>
</config>